# Raw Workshop snapshots are reference data. Keep source and manifests readable,
# but store all binary assets through Git LFS.
third_party/workshop/** -text whitespace=-trailing-space,-space-before-tab
third_party/workshop/**/*.mdl filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.vvd filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.vtx filter=lfs diff=lfs merge=lfs -text
