third_party/workshop/**/*.vmt filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.wav filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.ogg filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.pcf filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.png filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.jpg filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.gif filter=lfs diff=lfs merge=lfs -text
third_party/workshop/**/*.tga filter=lfs diff=lfs merge=lfs -text
